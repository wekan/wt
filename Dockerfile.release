# One release tarball of wt for ONE platform: the reader built against each WiredTiger a mongod
# 3.0 - 8.x was linked with.
#
#   docker buildx build --platform linux/arm64 -f Dockerfile.release --target dist --output type=local,dest=out .
#
# BASE is debian:bookworm where it exists. Debian bookworm has NO s390x or riscv64 image
# ("no match for platform in manifest"), trixie has both, so the workflows pass
# --build-arg BASE=debian:trixie for those two.
#
# A WiredTiger that does not build on a platform is left out instead of failing the release
# (mongodb-3.0's does not build on arm64: "No write barrier implementation for this hardware"),
# and the build output says why (build/try.sh). wt.mjs then says that this platform has no
# reader for that MongoDB, which is the truth, rather than the platform having no wt at all.
ARG BASE=debian:bookworm
FROM ${BASE} AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates build-essential cmake ninja-build autoconf automake libtool libtool-bin \
    python3 python3-dev swig libsnappy-dev zlib1g-dev libzstd-dev \
 && rm -rf /var/lib/apt/lists/*
COPY wt-mongo-dump.c /src/wt-mongo-dump.c
COPY build/ /build/

FROM base AS w11
ARG WT11_BRANCH=mongodb-8.0
RUN bash /build/try.sh 11.3 /build/w11.sh ${WT11_BRANCH}

FROM base AS w31
ARG WT31_BRANCH=mongodb-4.0
RUN bash /build/try.sh 3.1 /build/w31.sh ${WT31_BRANCH}

FROM base AS w25
ARG WT25_BRANCH=mongodb-3.0
RUN bash /build/try.sh 2.5 /build/w25.sh ${WT25_BRANCH}

FROM scratch AS dist
COPY --from=w11 /out/ /
COPY --from=w31 /out/ /
COPY --from=w25 /out/ /
COPY wt.mjs /wt.mjs
